# Team B Graph RAG Service - environment configuration.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real secrets.

# ---------------------------------------------------------------- Environment
# development | staging | production
# In production the app refuses to start while any placeholder secret remains.
ENVIRONMENT=development

# ---------------------------------------------------------------- ArcadeDB
ARCADEDB_URL=http://localhost:2480
ARCADEDB_USER=root
ARCADEDB_PASSWORD=playwithdata
ARCADEDB_QUERY_TIMEOUT_MS=3000
ARCADEDB_CONNECT_TIMEOUT_MS=2000
ARCADEDB_MAX_CONNECTIONS=50
ARCADEDB_WRITE_BATCH_SIZE=100

# ---------------------------------------------------------------- Authentication
# Maps each API key to the ONE tenant it may read. The key determines the tenant;
# a request asserting a different X-Tenant-ID is rejected with 403.
# Generate keys with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY_TENANT_MAP={"dev_movies_key_change_me":"movies_bot","dev_ai_trends_key_change_me":"ai_trends_bot"}

# Provisioning key. Never issue this to Team A. Empty disables admin endpoints.
ADMIN_API_KEY=

# ---------------------------------------------------------------- JWT (optional)
# Adds per-user traceability, expiry, and scopes on top of the API key.
# The tenant_id claim must match the API key's tenant or the request is denied.
JWT_ENABLED=false
JWT_REQUIRED=false
JWT_SECRET=dev_jwt_secret_change_me
JWT_ALGORITHM=HS256
JWT_ISSUER=team-a-chatbot-platform
JWT_AUDIENCE=team-b-retrieval-service

# ---------------------------------------------------------------- Limits
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=20
MAX_REQUEST_BODY_BYTES=1048576

# Tenant databases must be provisioned explicitly via POST /api/v1/tenant/provision.
# Leaving this true in production lets any tenant id create a database (disk DoS).
ALLOW_TENANT_AUTOPROVISION=false

# ---------------------------------------------------------------- CORS
# Comma-separated or a JSON array. Never '*' in production.
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------- Retrieval
DEFAULT_MAX_HOPS=2
MAX_TRAVERSAL_DEPTH=3
MAX_TRAVERSAL_NODES=100
DEFAULT_TOP_K=5
SIMILARITY_THRESHOLD=0.70
ENTITY_LINK_SIMILARITY=0.85
EDGE_CONFIDENCE_THRESHOLD=0.80
RRF_K=60

# ---------------------------------------------------------------- Models
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# Degrade to lexical scoring when model weights are unavailable, instead of
# failing requests. Set false in production to surface missing models loudly.
ALLOW_MODEL_FALLBACK=true

# gliner | spacy | regex  (requires requirements-ml.txt for the first two)
NER_BACKEND=regex

# ---------------------------------------------------------------- LLM (optional)
# FOSS-only build: the provider interface exists but no concrete provider is wired.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# ---------------------------------------------------------------- Chunking
CHUNK_TARGET_TOKENS=500
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
